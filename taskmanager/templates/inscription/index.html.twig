{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .box { max-width: 400px; margin: 3rem auto; padding: 1.5rem; border: 1px solid #ddd; border-radius: 10px; }
        .box form > div { margin-bottom: 1rem; }
        .box label { display: block; font-weight: bold; margin-bottom: .3rem; }
        .box input { width: 100%; padding: .5rem; box-sizing: border-box; }
        .error { background: #fee2e2; color: #b91c1c; padding: .6rem; border-radius: 6px; margin-bottom: 1rem; }
        .links { margin-top: 1rem; text-align: center; }
    </style>
{% endblock %}

{% block body %}
    <div class="box">
        <h1>Inscription</h1>

        {% if erreur %}
            <div class="error">❌ {{ erreur }}</div>
        {% endif %}

        <form method="post">
            <div>
                <label for="prenom">Prénom</label>
                <input type="text" id="prenom" name="prenom" value="{{ prenom }}" required autofocus>
            </div>

            <div>
                <label for="nom">Nom</label>
                <input type="text" id="nom" name="nom" value="{{ nom }}" required>
            </div>

            <div>
                <label for="email">Email</label>
                <input type="email" id="email" name="email" value="{{ email }}" required>
            </div>

            <div>
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="password" required>
            </div>

            <div>
                <label for="password_confirm">Confirmer le mot de passe</label>
                <input type="password" id="password_confirm" name="password_confirm" required>
            </div>

            <button type="submit" class="btn-solid btn-styled">Créer mon compte</button>
        </form>

        <div class="links">
            <a href="{{ path('app_login') }}">Déjà un compte ? Se connecter</a>
        </div>
    </div>
{% endblock %}