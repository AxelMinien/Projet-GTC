{% extends 'base.html.twig' %}

{% block title %}Utilisateur index{% endblock %}

{% block body %}
    <style>
        html, body {
            background-color: #ffffff !important;
        }

        h1 {
            color: #000000 !important;
        }

        .table,
        .table thead,
        .table tbody,
        .table tr,
        .table th,
        .table td {
            background-color: #6F7072 !important; 
            color: #FFFFFF !important;         
            border-color: #8A8B8D !important;
        }
    </style>
    <h1>Utilisateur index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Email</th>
                <th>Role</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for utilisateur in utilisateurs %}
            <tr>
                <td>{{ utilisateur.nom }}</td>
                <td>{{ utilisateur.prenom }}</td>
                <td>{{ utilisateur.email }}</td>
                <td>{{ utilisateur.role }}</td>
                <td>
                    <div style="display:flex; gap:.5rem; align-items:center;">
                        <a href="{{ path('app_utilisateur_show', {'id': utilisateur.id}) }}" class="btn-solid btn-styled theme-info">Show</a>
                        <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}" class="btn-solid btn-styled theme-inverse">Edit</a>
                        {{ include('utilisateur/_delete_form.html.twig') }}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

   <a href="{{ path('app_utilisateur_new') }}"><button class="btn-solid btn-styled theme-secondary">Create new</button></a>
{% endblock %}
