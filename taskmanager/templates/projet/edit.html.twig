{% extends 'base.html.twig' %}

{% block title %}Edit Projet{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .box { max-width: 500px; margin: 2rem auto; padding: 1.5rem; border: 1px solid #ddd; border-radius: 10px; }
        .box form > div { margin-bottom: 1rem; }
        .box label { display: block; font-weight: bold; margin-bottom: .3rem; }
        .box input, .box textarea, .box select { width: 100%; padding: .5rem; box-sizing: border-box; }
    </style>
{% endblock %}

{% block body %}
    <div class="box">
        <h1>Edit Projet</h1>

        {{ include('projet/_form.html.twig', {'button_label': 'Update'}) }}

        <a href="{{ path('app_projet_index') }}"><button class="btn-solid btn-styled theme-secondary">Back to list</button></a>

        {{ include('projet/_delete_form.html.twig') }}
    </div>
{% endblock %}