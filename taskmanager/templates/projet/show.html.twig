{% extends 'base.html.twig' %}

{% block title %}Projet{% endblock %}

{% block body %}
    <h1>Projet</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ projet.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ projet.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ projet.description }}</td>
            </tr>
            <tr>
                <th>DateCreation</th>
                <td>{{ projet.dateCreation ? projet.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_projet_index') }}" class="btn-solid btn-styled theme-secondary">Back to list</a>

    <a href="{{ path('app_projet_edit', {'id': projet.id}) }}" class="btn-solid btn-styled theme-inverse">Edit</a>

    {{ include('projet/_delete_form.html.twig') }}
{% endblock %}
